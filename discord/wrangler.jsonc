{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multisweeper-discord",
  // Pinned so a deploy can never land in another Cloudflare account on this login.
  "account_id": "383ec31951d8cf2003b67dfc1db3e378",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/Build/*"]
  },
  "observability": { "enabled": false }
}
